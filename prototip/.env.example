APP_NAME="Prototip F2.0"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

APP_LOCALE=hr
APP_FALLBACK_LOCALE=hr

# Dnevnik je dokazni materijal poglavlja 7, pa ide u jednu datoteku.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

# Prototip nema sesije, predmemoriju ni red poslova. Odlazni pretinac je
# vlastita tablica, ne Laravelov queue -- vidi odjeljak 7.2.
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
